# Postgres connection (docker-compose default shown below)
DATABASE_URL="postgresql://freely:freely@localhost:5432/freely"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Server-side only — never exposed to the client
ANTHROPIC_API_KEY="sk-ant-..."

# --- Optional features below — the app runs fine without any of these,
# --- each feature just stays disabled/greyed out until you fill it in. ---

# Encrypts OAuth tokens (e.g. the Figma connector) at rest.
# Generate with: openssl rand -base64 32
FREELY_ENCRYPTION_KEY="replace-with-a-random-secret"

# Stripe — enables real "Send for payment" invoicing (Track → Invoice).
# From https://dashboard.stripe.com/apikeys (use a test key while developing).
STRIPE_SECRET_KEY="sk_test_..."
# From the Stripe CLI (`stripe listen --forward-to localhost:3000/api/webhooks/stripe`)
# or from the webhook endpoint you create in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET="whsec_..."

# Figma — enables the Connectors tab's "Connect" button for Figma (Memory).
# Create an OAuth app at https://www.figma.com/developers/apps with callback
# URL {NEXTAUTH_URL}/api/connect/figma/callback
FIGMA_CLIENT_ID=""
FIGMA_CLIENT_SECRET=""

# Google login — enables "Continue with Google" on the sign-in page.
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# (Application type: Web application) with authorized redirect URI
# {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must be set to "true" (client-visible) whenever the two values above are
# set, so the sign-in page knows to show the button. Keep these in sync.
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED="false"
