generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id        String   @id @default(cuid())
  name      String
  ownerId   String   @unique
  createdAt DateTime @default(now())

  owner   User          @relation("TeamOwner", fields: [ownerId], references: [id])
  members User[]        @relation("TeamMember")
  invites TeamInvite[]
}

model TeamInvite {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email     String?
  token     String   @unique @default(cuid())
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([teamId])
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  // Nullable so Google-only accounts (no password set) can exist. The
  // Credentials provider must reject sign-in attempts where this is null.
  passwordHash       String?
  // Basic info collected at signup — kept minimal on purpose (no phone,
  // address, or other collection yet). Both optional so existing accounts
  // created before this field existed aren't broken.
  name               String?
  studioName         String?
  memoryInstructions String   @default("") @db.Text
  toneNotes          String   @default("") @db.Text
  storyNotes         String   @default("") @db.Text
  contextNotes       String   @default("") @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Onboarding: broad industry category, used to tailor default prompts and
  // presets across Quote/Memory. Null until the user completes /onboarding.
  industry           String?

  // Where this freelancer is based, e.g. "Valencia, Spain". The single
  // biggest determinant of a defensible rate when there's no pricing history
  // to anchor to: what a designer can charge in London and in Buenos Aires
  // differ by multiples. Asked once and reused.
  location           String?

  // AI-synthesized persona — a short summary of who this freelancer is and
  // how they work, inferred from Story/Tone/Context/Files/industry/past
  // projects. Regenerated on demand; user can hand-edit to correct it.
  aiPersona          String?  @db.Text
  personaUpdatedAt   DateTime?

  // Branding applied to the public client site, public quote pages, and PDF
  // export. All optional — falls back to Freely's default look.
  brandPrimaryColor  String?
  brandAccentColor   String?
  brandLogoDataUrl   String?  @db.Text
  // Font names detected from an uploaded brand-guide PDF (see
  // analyzeBrandGuideAction) — informational for now, not yet applied to
  // rendered PDFs/pages automatically.
  brandHeadingFont   String?
  brandBodyFont      String?

  // Default currency (ISO 4217 code, e.g. "USD") for new quotes — set in
  // Memory → Branding. Each Brief/Project stores its own currency too, so
  // changing this later doesn't rewrite past quotes.
  currency           String   @default("USD")

  // The freelancer's own Stripe account, linked through Stripe Connect.
  //
  // Only the account id lives here. It is an identifier Stripe hands back, not
  // a credential: on its own it authorises nothing, and every call using it is
  // signed with Freely's platform key. No card details, no bank details, no
  // keys belonging to the freelancer are stored anywhere in this database.
  //
  // Charges are created directly on this account, so their client's money goes
  // from the client to the freelancer. Freely is never in the middle of it and
  // never holds it.
  stripeAccountId    String?
  // Whether Stripe has finished its checks and will let this account take
  // money. Separate from having an account id because the two are days apart
  // in practice: Stripe issues the id immediately and then asks for identity
  // documents, and offering a Pay button in between produces a checkout that
  // fails in front of the client. Refreshed from Stripe rather than assumed.
  stripeChargesEnabled Boolean @default(false)
  // When the checks last came back clear, for saying so on the settings page.
  stripeConnectedAt  DateTime?

  // Which pieces of the guide this person has already been shown.
  //
  // Stored as a list of step names rather than a column per step, because the
  // set of steps is a product decision that will change and a boolean column
  // per hint is a migration every time somebody adds one.
  //
  // On the account rather than in the browser: a hint that reappears because
  // somebody opened Freely on their phone is a hint that reads as a bug.
  guideSeen          String[] @default([])

  notifications      Notification[]
  // The rate this freelancer usually charges, and whether it is per hour or
  // per day. Prefilled into every quote so it is not retyped, and still
  // editable per quote, since one job is not always priced like the last.
  // "en" or "es". Guessed from the browser on first sign-in, then whatever
  // they choose, saved on the account so it follows them between devices.
  locale             String   @default("en")
  // The language client-facing quotes are written in, which is a different
  // question from the language of the interface: a Spanish freelancer often
  // has English clients and the reverse. Nullable rather than defaulted, so
  // "not chosen" is distinguishable from "chosen to match the interface", and
  // an untouched account follows the interface instead of being stuck on a
  // guess made at signup.
  quoteLocale        String?

  // When the "did you land these?" prompt was last closed.
  //
  // A timestamp rather than a boolean, so closing it hides the quotes that
  // were in it without hiding it forever: anything quoted after this date
  // brings it back. A boolean would mean one dismissal silently switches the
  // feature off for good, which is not what closing something means.
  quotePromptDismissedAt DateTime?
  defaultRate        Float?
  defaultRateUnit    String   @default("HOUR")

  // The quote setup: everything the wizard used to ask on every quote that is
  // actually a property of the freelancer rather than of the job. Asking for
  // it once and remembering it is what took the first screen from fourteen
  // fields to four lines.
  //
  // All nullable, and null means "never said", which is different from any
  // particular value. A null section set is why the first quote still shows
  // the full choice and the second one shows a summary: there is nothing to
  // summarise until something has been chosen.
  //
  // How you usually split payment, and how much is due before you start.
  defaultPaymentPlan String?
  defaultUpfrontPercent Int?
  // Which sections you usually send, as the inclusion keys. Json rather than
  // seven booleans: the set of sections has changed twice already and each
  // change would otherwise be a migration.
  defaultSections    Json?
  // The answers to the questions each section rests on. Same text every time
  // for most people, which is why retyping them was the worst of it.
  defaultTermsNote   String   @default("") @db.Text
  defaultRevisionsNote String @default("") @db.Text
  defaultAiUsageNote String   @default("") @db.Text
  defaultAvailabilityNote String @default("") @db.Text
  // How it comes out and how it looks.
  defaultFormat      String?
  defaultTemplate    String?
  defaultBranding    String?

  // Seniority, which only moves a number when there is no rate to anchor to:
  // if you say £65/hour, the level adds nothing that figure does not already
  // say. So it is not a question on the wizard any more.
  //
  // Two columns, because a guess and a statement are not the same fact.
  // expertiseLevel is what you said, and it always wins. inferredExpertise is
  // read off your persona, files and past quotes, and is only used when you
  // have not said. Collapsing them into one column would mean an inference
  // overwriting a correction, which is the one thing it must never do.
  expertiseLevel     String?
  inferredExpertise  String?
  inferredExpertiseAt DateTime?

  // Consent to marketing email, and the evidence for it.
  //
  // Three columns rather than one boolean, because consent is a claim you have
  // to be able to support: what they agreed to, when, and where they were when
  // they agreed. A lone true/false cannot answer any question anybody would
  // actually ask about it.
  //
  // Defaults to false and is never set by anything other than somebody ticking
  // a box themselves. A pre-ticked box is not consent.
  marketingOptIn     Boolean  @default(false)
  marketingOptInAt   DateTime?
  // Where it was given: "signup", "account". Free text rather than an enum
  // because it is a record of history and history keeps happening.
  marketingOptInSource String?
  // Lets somebody unsubscribe from a link without signing in, which is the
  // only kind of unsubscribe that is any use: the whole point is that they do
  // not want to deal with you. Nullable so it only exists once needed, and
  // rotated on unsubscribe so an old email cannot resubscribe anybody.
  unsubscribeToken   String?  @unique

  // Whether the nudges are wanted.
  //
  // Separate from marketing consent and defaulted on, because these are about
  // this person's own work and their own money: a quote sitting untracked, a
  // deliverable past its date. Turning them off is one switch and it is not
  // buried.
  nudgeEmails        Boolean  @default(true)
  // When a nudge was last sent, whatever kind. One a day at most, and the log
  // could answer this, but a column keeps the daily cap off a table scan.
  lastNudgeAt        DateTime?

  // A user either owns a team (TeamOwner) or belongs to one as a member
  // (TeamMember, via teamId). Solo users have neither set.
  ownedTeam Team?   @relation("TeamOwner")
  teamId    String?
  team      Team?   @relation("TeamMember", fields: [teamId], references: [id])

  briefs      Brief[]
  projects    Project[]
  passwordResets PasswordReset[]
  emails         EmailLog[]
  events         Event[]
  assets      MemoryAsset[]
  connections Connection[]
  invoices    Invoice[]
}

model MemoryAsset {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        MemoryAssetType
  name        String
  textContent String?         @db.Text
  dataUrl     String?         @db.Text
  // Only set for type=LINK — a reference URL (portfolio piece, style guide,
  // brand doc) saved to Memory without needing a file upload.
  url         String?

  createdAt   DateTime        @default(now())

  @@index([userId])
}

enum MemoryAssetType {
  FILE
  IMAGE
  LINK
}

enum ConnectionProvider {
  FIGMA
  NOTION
  GITHUB
  // Calendar only. Signing in with Google does not grant this and must not:
  // reading somebody's identity and writing to their calendar are different
  // permissions and they are asked for at different moments, because "let me
  // put your deadlines in your calendar" is a sentence that deserves its own
  // yes.
  GOOGLE_CALENDAR
}

model Connection {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          ConnectionProvider
  accountLabel      String?
  accessTokenCipher String              @db.Text
  refreshTokenCipher String?            @db.Text
  expiresAt         DateTime?
  createdAt         DateTime            @default(now())

  @@unique([userId, provider])
}

model Brief {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  client         String
  scope          String      @db.Text
  deliverables   Json
  timeline       String
  // Structured Strategy section — { goal, findings[], aiWill[], aiWillNot[],
  // openQuestions[] } — kept as JSON (not a prose blob) so every renderer
  // (brief view, PDF, public page) can lay it out as real bulleted sections.
  strategy       Json?
  // The optional add-on sections (terms, revisions policy, availability,
  // payment terms), kept as one JSON blob so adding another doesn't need a
  // schema change. Never holds bank details: see briefExtrasSchema.
  extras         Json?
  price          Float
  hours          Float
  hourlyRate     Float?
  // "HOUR" or "DAY". Plenty of freelancers price in days and translating to
  // an hourly figure to fit the form means inventing a day length. The stored
  // rate is always per this unit, and hours stays the underlying estimate.
  rateUnit       String      @default("HOUR")
  // The language this quote is written in, which is not always the language
  // the freelancer works in: a Spanish designer often has English clients.
  language       String      @default("en")
  // ISO 4217 code (e.g. "USD", "EUR") — defaults from the user's saved
  // preference at generation time, but can differ per quote.
  currency       String      @default("USD")
  expertiseLevel String?
  status         BriefStatus @default(DRAFT)
  sourceText     String?     @db.Text
  settings       Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Public, shareable "HTML page" quote — mirrors Project's publicSlug
  // pattern. published gates visibility; publicSlug is the stable URL.
  published      Boolean     @default(false)
  publicSlug     String      @unique @default(cuid())
  // Which of the 3 public-page visual templates to render at /q/[publicSlug].
  template       String      @default("classic")

  // Client acceptance, captured on the public page: a simple electronic
  // signature (typed name plus an explicit tick), which is what most
  // freelance engagements actually run on. Deliberately not a full e-sign
  // provider: that needs a paid account and an envelope lifecycle, and can
  // be layered on later without changing these fields.
  acceptedAt     DateTime?
  acceptedName   String?
  acceptedEmail  String?
  // Kept only as evidence of who accepted, alongside the timestamp.
  acceptedIp     String?

  // Whether this one landed. Set either by answering the prompt on the quotes
  // list, or automatically when a client signs the quote on its public page.
  outcome          QuoteOutcome @default(PENDING)
  outcomeAt        DateTime?
  // When the freelancer was shown that this quote had been signed. Null while
  // an acceptance is still unseen, which is what the banner keys off.
  acceptanceSeenAt DateTime?
  // Which color/logo treatment to render with: "freely" (Freely's own look),
  // "own" (this freelancer's saved brand colors/logo from Memory), or a
  // built-in neutral preset not tied to either ("mono-light"/"mono-dark").
  // Chosen per-quote in the wizard, applied to both the public page and PDF.
  branding       String      @default("freely")

  project  Project?
  examples BriefExample[]

  @@index([userId])
}

// A reference file (screenshot, moodboard, past landing page, etc.) attached
// to a quote with a caption explaining how it applies — e.g. "this is a
// landing page I built — I'd apply a similar structure here" or "this
// moodboard is the visual direction I'd take the branding in." Shown on the
// brief page, in the PDF export, and on the public quote page.
model BriefExample {
  id        String   @id @default(cuid())
  briefId   String
  brief     Brief    @relation(fields: [briefId], references: [id], onDelete: Cascade)
  name      String
  dataUrl   String   @db.Text
  caption   String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([briefId])
}

enum BriefStatus {
  DRAFT
  TRACKED
}

// Whether the work was actually won.
//
// Separate from BriefStatus, which is about where the quote is in Freely
// (drafted, sent to Track). This is about what happened in the world, and the
// two genuinely differ: a quote can be tracked and then fall through, and a job
// can be won weeks before anyone remembers to track it.
//
// PENDING is the honest default. It means nobody has said, not that it was
// lost, which matters because the win rate is only meaningful against quotes
// that have actually been decided.
enum QuoteOutcome {
  PENDING
  WON
  LOST
}

model Project {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  briefId     String?       @unique
  brief       Brief?        @relation(fields: [briefId], references: [id])
  title       String
  client      String
  // Which register the client's page is written in. False is the tracker's own
  // words, which suits a technical client who wants the detail, and reads as
  // somebody else's task list to a client who is buying an outcome. Per project
  // rather than per account, since one freelancer has both kinds of client.
  plainLanguage Boolean @default(false)
  status      ProjectStatus @default(ACTIVE)
  price       Float         @default(0)
  hours       Float         @default(0)
  hoursLogged Float         @default(0)
  timeline    String        @default("")
  currency    String        @default("USD")
  // When the work actually starts. Everything else in Track hangs off this:
  // the quote's timeline says "Week 1-2", which only becomes a date once
  // there is a day one. Null means the project has not been scheduled yet.
  startDate   DateTime?
  // The end of the whole engagement, derived from the last stage but
  // editable, since the client's deadline often differs from the estimate.
  dueDate     DateTime?
  published   Boolean       @default(false)
  publicSlug  String        @unique @default(cuid())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // How this project gets billed, which decides when it can be invoiced.
  // Set by the freelancer rather than inferred from the quote's payment terms:
  // that text is free-form prose, and guessing wrong here means either
  // withholding an invoice that is due or offering one that is not.
  billing     BillingMode   @default(ON_COMPLETION)

  invoiceStatus      InvoiceStatus @default(UNPAID)
  stripeCheckoutUrl  String?
  stripeSessionId    String?
  stripePaymentIntentId String?

  deliverables Deliverable[]
  milestones   Milestone[]
  diaryEntries DiaryEntry[]

  @@index([userId])
}

// A billable chunk of the work, grouping one or more deliverables.
//
// Not the same thing as a deliverable, which is what this used to assume: a
// six-deliverable project billed in three milestones was invoicing in six
// pieces, each a sixth of the price, which is simply the wrong number on the
// wrong day.
//
// Decided when the quote is written, not in the tracker. The freelancer says
// how the work splits (or lets it be worked out), the client agrees to that
// split, and Track displays what was agreed rather than offering to rearrange
// it afterwards.
//
// amount is stored rather than derived. A milestone's share is agreed with the
// client at quote time, and recomputing it later from hours would silently
// change what someone signed for when a deliverable is edited.
model Milestone {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  order     Int     @default(0)
  // What closes this milestone beyond its deliverables: a direction agreed, a
  // decision made, access granted. Usually the client's move, and usually the
  // reason the next milestone cannot start yet.
  gate      String?
  // This milestone's share of the project price, as quoted.
  amount    Float   @default(0)
  // When this milestone was billed. Null means it is still outstanding, which
  // is what puts it in the invoice queue.
  invoicedAt DateTime?

  deliverables Deliverable[]

  @@index([projectId])
}

/// An invoice. Note what is NOT here: no bank account, sort code, IBAN or any
/// other payment credential. Those are typed into the form each time an
/// invoice is rendered, passed straight to the PDF, and never written down.
/// Keeping them out of the database means a breach here exposes no payment
/// details, and it's why the PDF is generated on demand rather than stored.
model Invoice {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Sequential per user, so invoice numbers read 0001, 0002 and so on rather
  /// than exposing a random id to the client.
  number    Int
  issuedAt  DateTime @default(now())
  dueAt     DateTime
  /// A free-text reference the client quotes when paying.
  reference String   @default("")

  /// Who it's billed to. Denormalised on purpose: an invoice is a record of
  /// what was sent, so later edits to a project or client must not rewrite it.
  clientName    String @default("")
  clientCompany String @default("")
  clientWebsite String @default("")
  clientEmail   String @default("")

  /// Who it's from, likewise frozen at issue time.
  fromName    String @default("")
  fromWebsite String @default("")
  fromEmail   String @default("")
  fromAddress String @default("")
  /// The line under the sender's name, e.g. "UX design · Product design · CRO".
  fromTagline String @default("")

  /// [{ title, description, rate, hours, amount }]
  lineItems Json
  /// Whether the client sees the deliverables and hours, or one line and a
  /// total. Stored rather than chosen at download time, so re-downloading an
  /// invoice produces the document that was sent.
  itemised  Boolean @default(true)
  currency  String  @default("USD")
  /// Percentage, e.g. 21 for 21%. Zero means the tax row is omitted entirely.
  taxRate   Float   @default(0)
  notes     String  @default("") @db.Text

  /// Mirrors the quote's own options so an invoice looks like the quote it
  /// followed. See lib/branding.ts.
  branding String @default("freely")
  template String @default("classic")

  paid   Boolean @default(false)
  paidAt DateTime?

  projectId String?
  briefId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, number])
  @@index([userId])
}

enum ProjectStatus {
  ACTIVE
  DUE
  OVERDUE
  DONE
}

/// ON_COMPLETION: one invoice, once the whole project is done.
/// PER_MILESTONE: one invoice per deliverable, as each is finished.
enum BillingMode {
  ON_COMPLETION
  PER_MILESTONE
}

enum InvoiceStatus {
  UNPAID
  PENDING
  PAID
}

model Deliverable {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Which milestone this belongs to. Null on a project that is not billed in
  // milestones, which is most of them.
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  name      String
  done      Boolean @default(false)
  order     Int     @default(0)
  // Derived from the quote's timeline against the project start date, then
  // editable. Null until the project is scheduled.
  dueAt     DateTime?
  // One line of AI-written context on what this deliverable actually means
  // for this project, written alongside the steps.
  summary   String? @db.Text
  // Set once the steps and flags have been generated, so the UI can tell
  // "not broken down yet" apart from "broken down into nothing".
  brokenDownAt DateTime?
  // When this deliverable was billed, on a per-milestone project. Null means
  // it is still outstanding, which is what puts it in the invoice queue. A
  // date rather than a boolean, because "when did I bill that" is a question
  // worth being able to answer.
  invoicedAt DateTime?
  // When it was ticked off. `done` says whether, this says when, which is the
  // difference between "4 of 6 done" and "you finished three of those today".
  // Cleared when something is unticked, so a correction does not leave a
  // completion date on unfinished work.
  doneAt    DateTime?
  // The Google Calendar event this became, if the freelancer connected one.
  //
  // Stored so a date change updates the event that exists rather than creating
  // a second one, and so deleting the work can delete the event. Null means
  // there is no event, which is the normal case.
  calendarEventId String?
  // The same deliverable said in plain language, for the client's page.
  // "Swap font from Inter to Sohne across all 13 text styles" is a task; a
  // client is buying "the brand typeface applied everywhere". Written once and
  // then editable, so a correction is not overwritten by a regeneration.
  // Null means it has not been written yet, which is why the toggle can ask
  // for it on demand rather than at project creation.
  clientName String? @db.Text

  steps Step[]
  flags Flag[]

  @@index([projectId])
  @@index([milestoneId])
}

// One concrete action inside a deliverable. "Foundations in Figma" is not a
// thing anyone can sit down and do; "Audit the existing type styles and list
// every size in use" is. Generated by AI, then edited and ticked off by hand,
// so nothing here is treated as immutable.
model Step {
  id            String      @id @default(cuid())
  deliverableId String
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  name          String      @db.Text
  done          Boolean     @default(false)
  order         Int         @default(0)
  // Rough estimate in hours, used to weight progress so ticking off a
  // ten-minute task does not look like the same amount of work as a two-day
  // one. Zero means unestimated.
  estimateHours Float       @default(0)
  createdAt     DateTime    @default(now())

  @@index([deliverableId])
}

// Something worth raising with the client before or while doing a
// deliverable: a gap in the brief, an assumption being made, a dependency
// that will stall the work. The Track equivalent of a quote's open
// questions, but scoped to the piece of work in hand rather than the project
// as a whole.
model Flag {
  id            String      @id @default(cuid())
  deliverableId String
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  question      String      @db.Text
  // Why it matters, one line. Kept separate from the question so the UI can
  // lead with the question and keep the reasoning secondary.
  reason        String?     @db.Text
  // BLOCKER, ASSUMPTION or WORTH_ASKING, see FlagKind.
  kind          FlagKind    @default(WORTH_ASKING)
  resolved      Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([deliverableId])
}

enum FlagKind {
  // The work cannot proceed properly until this is answered.
  BLOCKER
  // Proceeding on an assumption, which should be stated out loud.
  ASSUMPTION
  // Not urgent, but the project goes better if it is asked.
  WORTH_ASKING
}

model DiaryEntry {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date          DateTime @default(now())
  title         String
  body          String   @db.Text
  autoGenerated Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([projectId])
}


 // A password reset in progress.
 //
 // The token is stored hashed, never in the clear. Anyone with read access to
 // this table, including a leaked backup, would otherwise be able to take over
 // every account with a reset outstanding, which is a worse position than
 // storing passwords badly.
 //
 // Rows are kept after use rather than deleted, so a used token can be told
 // apart from one that never existed, and so a burst of requests is visible.
// Something that happened, that this freelancer should know about.
//
// Separate from EmailLog on purpose. That records what was sent; this records
// what happened. The two overlap because most notifications are also emailed,
// but a person who turned emails off still has a bell, and an email that
// bounced is still something that happened.
//
// Separate from Event too, which is the product's own analytics and is never
// shown to the person it is about.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind      NotificationKind
  // Written at the time rather than rendered from the kind on read, so a
  // notification about a project that has since been deleted still says what
  // it said. Rebuilding the sentence later means holding onto rows that only
  // exist to make old notifications readable.
  title     String
  body      String   @db.Text

  // Where it goes when clicked. Nullable, since not everything has a page.
  href      String?
  // The project or quote it is about, for collapsing repeats.
  subjectId String?

  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

enum NotificationKind {
  // A client accepted a quote. The one that matters most.
  QUOTE_ACCEPTED
  // A client paid an invoice.
  INVOICE_PAID
  // Something is due, or has slipped past its date.
  DEADLINE
  // A signed quote that is not being tracked yet.
  UNTRACKED
  // Everything else worth a line.
  GENERAL
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token that was emailed. The plaintext exists only in that
  /// one email and in the URL the person clicks.
  tokenHash String   @unique
  expiresAt DateTime
  /// Set the moment it is spent. A reset link is single use: an email sitting
  /// in an inbox for a year must not still open the account.
  usedAt    DateTime?
  createdAt DateTime @default(now())
  /// Kept to spot somebody hammering the form, not to identify anybody.
  requestIp String?

  @@index([userId])
  @@index([expiresAt])
}

 // Every email the app has tried to send.
 //
 // Three jobs, and the first is the reason it exists: a nudge that has already
 // been sent must not be sent again, and without a record the only way to know
 // is to guess from the state that triggered it.
 //
 // It also makes a failure visible. Sending is best effort by design, so a
 // bounced or rejected message otherwise disappears silently and the freelancer
 // is left wondering why a client never replied.
 //
 // And it answers "did that actually go out", which is the question every
 // support conversation about email starts with.
 //
 // No body is stored. Knowing that a reset email was sent is operations; keeping
 // its contents is keeping a copy of somebody's mail.
model EmailLog {
  id        String      @id @default(cuid())
  /// Null for mail to somebody who is not a user, such as a client accepting a
  /// quote.
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  to        String
  kind      EmailKind
  subject   String
  status    EmailStatus @default(SENT)
  /// Why it failed, when it did. Provider wording, kept for diagnosis.
  error     String?     @db.Text
  /// What it was about, so a nudge can find its own last send without
  /// scanning subjects. A brief id, a project id, or null.
  subjectId String?
  createdAt DateTime    @default(now())

  @@index([userId, kind, createdAt])
  @@index([subjectId])
}

enum EmailStatus {
  SENT
  FAILED
  /// Configured off, so nothing was attempted. Recorded rather than dropped:
  /// "no key set" and "we never tried" look identical afterwards otherwise.
  SKIPPED
}

 // What an email is for.
 //
 // The distinction that matters is transactional against marketing, because only
 // one of them is allowed to be sent to somebody who has opted out. Everything
 // up to and including NUDGE_* is transactional: it is about work this person is
 // doing and money they are owed.
enum EmailKind {
  PASSWORD_RESET
  QUOTE_ACCEPTED
  TEAM_INVITE
  NUDGE_TRACK_QUOTE
  NUDGE_DUE_SOON
  NUDGE_OVERDUE
  MARKETING
}


// Something that happened, worth counting later.
//
// Written from the app's own code rather than from a script in the browser, so
// an ad blocker cannot silence it and no third party is involved. That is the
// point of having this at all: the numbers are about the product, they come
// from the database that already holds the truth, and nobody outside gets a
// copy.
//
// One row per event, kept deliberately thin. What happened, who it happened to,
// when, and a small bag of detail. No page views, no session recording, no
// mouse movements: those answer questions nobody here is asking and they turn a
// product database into a surveillance one.
//
// userId is nullable and set to null when an account is deleted rather than
// cascading, because "someone generated 40 quotes in March" stays true after
// they leave, and the row no longer points at a person.
model Event {
  id        String   @id @default(cuid())
  kind      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // What it was about: a brief id, a project id, an invoice id. Enough to count
  // distinct things without joining, and to spot double counting.
  subjectId String?
  // A handful of numbers or short strings. Price, hours, language, whether AI
  // research ran. Never free text somebody typed, and never a client's name.
  detail    Json?
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([userId, createdAt])
}
