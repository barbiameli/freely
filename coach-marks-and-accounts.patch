+    expect(recentAccounts(accounts).map((a) => a.email)).toEqual([
+      "b@example.com",
+      "c@example.com",
+      "a@example.com",
+    ]);
+  });
+
+  it("does not reorder the list it was given", () => {
+    const original = [...accounts];
+    recentAccounts(accounts);
+    expect(accounts).toEqual(original);
+  });
